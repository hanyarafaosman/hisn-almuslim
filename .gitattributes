# Quran text/data must stay byte-identical to the verified KFGQPC files
www/quran/** -text
*.woff2 binary
*.png binary
*.jpg binary
# Each book file is named after the hash of its bytes (scripts/build-kutub.js)
www/kutub/*.json -text
# Adhan recordings are named after the hash of their bytes (scripts/build-adhan.js)
www/adhan/*.aac binary
